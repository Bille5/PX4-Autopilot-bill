#!/bin/sh
#
# ASAD-v1.1 board specific sensors init
#------------------------------------------------------------------------------

# IMU - ICM-20948 on I2C1 bus (PB8/PB9)
icm20948_i2c_passthrough -I -b 1 -a 0x68 -A start

# Barometer - LPS22HH on I2C1 bus (shared with IMU)
lps22hb -H -I -b 1 -a 0x5c -f 100 start

# Power monitor - INA226 on I2C2 bus (PB10/PB11)
ina226 -I -b 2 -a 0x40 start

# Wait for the ICM-20948 to enable passthrough to its compass.
usleep 100000
ak09916 -I -b 1 -a 0x0c start
